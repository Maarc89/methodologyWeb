# ==========================
# Backend .env example
# ==========================

# Environment: development or production
DJANGO_ENV=development

# Django
# SECRET_KEY: generate and paste here in production
SECRET_KEY=
ALLOWED_HOSTS='localhost'

# Database (Postgres)
# Format: postgres://<user>:<pass>@<host>:<port>/<dbname>
DATABASE_URL=postgres://<usuario>:<contraseña>@<host>:<puerto>/<basededatos>

# --------------------------
# Keycloak / OpenID Connect
# --------------------------
# Alternative URL to obtain JWKS (useful in environments with internal proxy)
KEYCLOAK_JWKS_URL_ALT=
# Optional local path to a jwks.json file
KEYCLOAK_JWKS_LOCAL_FILE=
# Alternative URL of the Keycloak server (e.g., https://nginx/auth/)
KEYCLOAK_SERVER_URL_ALT=
# Timeout (seconds) for requests to Keycloak
KEYCLOAK_REQUEST_TIMEOUT=10
# Disable SSL verification (True/False) — only in internal networks with self-signed certificates
KEYCLOAK_VERIFY=False

# --------------------------
# Credentials for administration tasks in Keycloak
# --------------------------
# If you use a client with service account (recommended), specify the client ID and secret.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
