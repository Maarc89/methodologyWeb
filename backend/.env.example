# Environment: development or production
DJANGO_ENV=development

# Django secret key (generate con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=

ALLOWED_HOSTS='localhost'

# PostgreSQL config
DATABASE_URL=postgres://<usuario>:<contraseña>@<host>:<puerto>/<basededatos>